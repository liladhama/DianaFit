# Конфигурация для локальной разработки
NODE_ENV=development
USE_LOCAL_STORAGE=true
FORCE_LOCAL_FILES=true

# Порт для локального сервера
PORT=3001

# Настройки для локального тестирования
LOCAL_TESTING=true

# Отключаем Firestore для локальной разработки
DISABLE_FIRESTORE=true

# Секретный ключ для JWT (для локального тестирования)
JWT_SECRET=your-local-jwt-secret-key-for-testing

# Настройки для Mistral API (если используется)
MISTRAL_API_KEY=AqUS2WOIZAR0Np79SnK4Zq2YmeQpqEvh
